+subroutine validate_absolute_boundary(rbd)
+        use constant
+        use, intrinsic :: ieee_arithmetic
+        implicit none
+        real(8),intent(in)::rbd
+        real(8) rh_pc,n0_pc3,rb_pc,mpart,beta,rhob,sigb,asymp,rel
+        integer iu,ios
+        logical have_profile
+        inquire(file="profile_norm.in",exist=have_profile)
+        if(.not.have_profile)return
+        open(newunit=iu,file="profile_norm.in",status="old",action="read",iostat=ios)
+        if(ios.ne.0) error stop "ABSOLUTE_CLOSURE: cannot validate boundary"
+        read(iu,*,iostat=ios) rh_pc,n0_pc3,rb_pc,mpart,beta,rhob,sigb,asymp
+        close(iu)
+        if(ios.ne.0.or.rb_pc.le.0d0) error stop "ABSOLUTE_CLOSURE: invalid boundary record"
+        rel=abs(rbd/pc-rb_pc)/rb_pc
+        if(.not.ieee_is_finite(rel).or.rel.gt.1d-10)then
+                print*,"ABSOLUTE_CLOSURE boundary mismatch",rbd/pc,rb_pc,rel
+                error stop "ABSOLUTE_CLOSURE: deck boundary is not r_in"
         end if
 end subroutine
